{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true, /* Ensure that casing is correct in imports. */
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true, /* Remove comments from output JS. */
    "resolveJsonModule": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "es6",
    "types": [
      "node",
      "express"
    ],
    "lib": [
      "es2020"
    ],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}