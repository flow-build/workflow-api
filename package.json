{
  "name": "@flowbuild/workflow",
  "version": "2.32.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tests": "ENGINE_LOG_LEVEL=error KOA_LOG_LEVEL=error jest --coverage --runInBand --forceExit",
    "test:single": "jest -i --detectOpenHandles --forceExit",
    "seeds": "knex --env ${KNEX_ENV} --knexfile knexfile.js seed:run",
    "seeds:local": "knex --env dockerLocal --knexfile knexfile.js seed:run",
    "migrations": "knex --env ${KNEX_ENV} --knexfile knexfile.js migrate:latest",
    "migrations:local": "knex --env dockerLocal --knexfile knexfile.js migrate:latest",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "get-version": "echo $npm_package_version",
    "release": "semantic-release",
    "export": "node ./scripts/export.js",
    "prebuild": "node -p \"'export const PACKAGE_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsc",
    "lint": "npx eslint \"**/*.ts\" --ignore-pattern node_modules/ --fix"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "12.0.2",
    "@stylistic/eslint-plugin": "5.1.0",
    "@types/amqplib": "0.10.7",
    "@types/cors": "2.8.19",
    "@types/jsrsasign": "10.5.15",
    "@types/traceparent": "1.0.2",
    "@types/useragent": "2.3.4",
    "@types/ws": "8.18.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "9.31.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jest": "30.0.4",
    "nodemon": "3.1.10",
    "semantic-release": "24.2.7",
    "supertest": "7.1.3",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.37.0"
  },
  "dependencies": {
    "@flowbuild/engine": "2.33.0",
    "@flowbuild/indexer": "1.0.2",
    "@flowbuild/nodejs-diagram-builder": "1.1.0",
    "@flowbuild/process-tree": "1.0.4",
    "@grpc/grpc-js": "1.13.4",
    "@grpc/proto-loader": "0.7.15",
    "@opentelemetry/api": "1.4.1",
    "@opentelemetry/auto-instrumentations-node": "0.36.4",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.36.1",
    "@opentelemetry/instrumentation-koa": "0.34.2",
    "@opentelemetry/resources": "1.10.1",
    "@opentelemetry/sdk-node": "0.36.1",
    "@opentelemetry/semantic-conventions": "1.10.1",
    "@supercharge/request-ip": "1.2.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "amqplib": "0.10.8",
    "async-mqtt": "2.6.3",
    "axios": "1.10.0",
    "cors": "2.8.5",
    "dotenv": "17.2.0",
    "express": "5.1.0",
    "express-jwt": "8.5.1",
    "gql-query-builder": "3.8.0",
    "grpc-client-promise-wrapper": "1.0.5",
    "grpc-reflection-js": "0.3.0",
    "helmet": "8.1.0",
    "jsrsasign": "11.1.0",
    "kafkajs": "2.2.4",
    "knex": "3.1.0",
    "lodash": "4.17.21",
    "nanoid": "5.1.5",
    "npm": "11.4.2",
    "pg": "8.16.3",
    "raw-body": "3.0.0",
    "swagger-ui-dist": "5.26.2",
    "typescript": "5.8.3",
