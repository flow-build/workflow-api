    "type": "git",
    "url": "https://github.com/flow-build/workflow.git"
  },
  "nodemonConfig": {
    "ext": "js",
    "ignore": [
      "**/samples/**"
    ]
  },
  "homepage": "https://github.com/flow-build/workflow#readme"
